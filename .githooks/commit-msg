#!/bin/sh

set -eu

commit_message_file="$1"
commit_subject="$(
    sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$commit_message_file" |
        sed -n '1p'
)"

# Allow messages generated by Git itself or by the autosquash workflow.
case "$commit_subject" in
    Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *)
        exit 0
        ;;
esac

general_pattern='^(feat|fix|docs|style|refactor|test|chore): \[[[:alnum:]_.-]+\]: .+$'
version_pattern='^(build|release): \[v[0-9]+\.[0-9]+\.[0-9]+(\([0-9]+\))?\]\[[[:alnum:]_-]+(\.[[:alnum:]_-]+)+\]: .+$'

if printf '%s\n' "$commit_subject" | grep -Eq "$general_pattern"; then
    exit 0
fi

if printf '%s\n' "$commit_subject" | grep -Eq "$version_pattern"; then
    exit 0
fi

echo "Commit blocked: invalid commit message."
echo
echo "Required formats:"
echo "  chore: [geonwoo.kim]: ktlint 적용"
echo "  release: [v1.0.2(8)][geonwoo.kim]: 내부 테스트 버전 릴리즈"
echo
echo "Allowed types:"
echo "  feat, fix, docs, style, refactor, test, chore, build, release"
exit 1
