<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <activity android:name=".MainActivity" android:launchMode="singleTop" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="owner-store-alerts" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_owner_notification" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <service android:name=".notification.OwnerMessagingService" android:exported="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter>
        </service>
    </application>
</manifest>
